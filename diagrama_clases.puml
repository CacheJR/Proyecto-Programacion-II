@startuml
skinparam classAttributeIconSize 0
class Cliente {
  - codigo: String
  - nombre: String
  - telefono: String
  - correo: String
  - fechaRegistro: LocalDate
  + actualizarContacto(telefono, correo): void
}
class Cancha {
  - codigo: String
  - nombre: String
  - tipo: TipoCancha
  - capacidad: int
  - precioBase: BigDecimal
  - estado: EstadoCancha
  - horaApertura: LocalTime
  - horaCierre: LocalTime
  + cambiarEstado(nuevoEstado): void
}
class Reserva {
  - codigo: String
  - cliente: Cliente
  - cancha: Cancha
  - fecha: LocalDate
  - horaInicio: LocalTime
  - duracionMinutos: int
  - horaFin: LocalTime
  - estado: EstadoReserva
  + confirmar(): void
  + iniciar(): void
  + finalizar(): void
  + cancelar(motivo, operador): void
}
enum EstadoCancha {
  DISPONIBLE
  MANTENIMIENTO
  INACTIVA
}
enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  EN_CURSO
  FINALIZADA
  CANCELADA
}
enum TipoCancha {
  FUTBOL_5
  FUTBOL_7
}
Cliente "1" <-- "0..*" Reserva : cliente
Cancha "1" <-- "0..*" Reserva : cancha
Cancha --> EstadoCancha
Cancha --> TipoCancha
Reserva --> EstadoReserva
@enduml
