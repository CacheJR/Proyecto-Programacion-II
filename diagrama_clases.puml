@startuml
skinparam classAttributeIconSize 0
class Cliente {
  - codigo: String
  - nombre: String
  - telefono: String
  + actualizarContacto(telefono, correo): void
}
class Cancha {
  - codigo: String
  - nombre: String
  - tipo: TipoCancha
  - estado: EstadoCancha
  - horaApertura: LocalTime
  - horaCierre: LocalTime
  + cambiarEstado(nuevoEstado): void
}
class Reserva {
  - codigo: String
  - cliente: Cliente
  - cancha: Cancha
  - fecha: LocalDate
  - horaInicio: LocalTime
  - horaFin: LocalTime
  - estado: EstadoReserva
  + confirmar(): void
  + cancelar(motivo, operador): void
  + agregarServicio(servicio): void
  + registrarPago(pago): void
  + getTotal(): BigDecimal
  + getSaldo(): BigDecimal
}
class Pago {
  - codigo: String
  - monto: BigDecimal
  - fechaHora: LocalDateTime
  - metodo: MetodoPago
}
class ServicioAdicional {
  - codigo: String
  - nombre: String
  - precio: BigDecimal
}
class CalculadoraTarifas {
  + tarifaPorHora(fecha, inicio): BigDecimal
  + costoCancha(fecha, inicio, minutos): BigDecimal
}
enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}
Pago --> MetodoPago
Reserva ..> CalculadoraTarifas
class ServicioDisponibilidad {
  - canchas: List<Cancha>
  - reservas: List<Reserva>
  + buscarDisponibles(tipo, fecha, inicio, minutos): List<Cancha>
  + estaDisponible(cancha, fecha, inicio, minutos): boolean
  + seTraslapan(inicioNuevo, finNuevo, inicioExistente, finExistente): boolean
  + registrarReserva(codigo, cliente, cancha, fecha, inicio, minutos): Reserva
}
enum EstadoCancha {
 DISPONIBLE
 MANTENIMIENTO
 INACTIVA
}
enum EstadoReserva {
 PENDIENTE
 CONFIRMADA
 EN_CURSO
 FINALIZADA
 CANCELADA
}
enum TipoCancha {
 FUTBOL_5
 FUTBOL_7
}
Cliente "1" <-- "0..*" Reserva : cliente
Cancha "1" <-- "0..*" Reserva : cancha
Cancha --> EstadoCancha
Cancha --> TipoCancha
Reserva "1" o-- "0..*" Pago : abonos
Reserva "1" o-- "0..*" ServicioAdicional : servicios
Reserva --> EstadoReserva
ServicioDisponibilidad --> "0..*" Cancha
ServicioDisponibilidad --> "0..*" Reserva
@enduml
