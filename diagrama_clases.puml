@startuml
left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
package "Modelo CORE" {
 class Cliente {
   - codigo: String
   - nombre: String
   - telefono: String
   + actualizarContacto(telefono, correo): void
 }
 class Cancha {
   - codigo: String
   - tipo: TipoCancha
   - estado: EstadoCancha
   - horaApertura: LocalTime
   - horaCierre: LocalTime
   + cambiarEstado(nuevoEstado): void
 }
 class Reserva {
   - codigo: String
   - cliente: Cliente
   - cancha: Cancha
   - fecha: LocalDate
   - horaInicio: LocalTime
   - horaFin: LocalTime
   - costoCanchaFijo: BigDecimal
   - estado: EstadoReserva
   + confirmar(): void
   + iniciar(): void
   + finalizar(): void
   + cancelar(motivo, operador): void
   + agregarServicio(servicio): void
   + registrarPago(pago): void
   + getTotal(): BigDecimal
   + getSaldo(): BigDecimal
 }
 class ServicioAdicional { - codigo: String\n- nombre: String\n- precio: BigDecimal }
 class Pago { - codigo: String\n- monto: BigDecimal\n- metodo: MetodoPago }
 enum EstadoCancha { DISPONIBLE\nMANTENIMIENTO\nINACTIVA }
 enum EstadoReserva { PENDIENTE\nCONFIRMADA\nEN_CURSO\nFINALIZADA\nCANCELADA }
 enum TipoCancha { FUTBOL_5\nFUTBOL_7 }
 enum MetodoPago { EFECTIVO\nTRANSFERENCIA\nTARJETA }
}
Reserva "0..*" --> "1" Cliente : cliente
Reserva "0..*" --> "1" Cancha : cancha
Reserva "1" o-- "0..*" Pago : abonos
Reserva "1" o-- "0..*" ServicioAdicional : servicios
Reserva --> EstadoReserva
Cancha --> EstadoCancha
Cancha --> TipoCancha
Pago --> MetodoPago
package "Servicios" {
 class ConfiguracionTarifas {
  - diurna: BigDecimal
  - nocturna: BigDecimal
  - finSemana: BigDecimal
 }
 class CalculadoraTarifas {
  + tarifaPorHora(fecha,inicio): BigDecimal
  + costoCancha(fecha,inicio,minutos): BigDecimal
 }
 class ServicioDisponibilidad {
  + buscarDisponibles(...): List<Cancha>
  + seTraslapan(...): boolean
  + registrarReserva(...): Reserva
 }
 class GestionRegistros {
  + registrarCliente(...): Cliente
  + registrarCancha(...): Cancha
  + registrarReservaCompleta(...): Reserva
  + registrarPagoReserva(...): void
  + cambiarEstadoReserva(...): void
 }
 class ServicioDashboard { + calcular(hoy): Resumen }
 class ServicioReportes { + generar(...): ResultadoReporte }
 class ResultadoReporte { - columnas: String[]\n- filas: List<Object[]> }
}
package "Datos" {
 class DatosSistema { - clientes: List<Cliente>\n- canchas: List<Cancha>\n- reservas: List<Reserva> }
 class ArchivosCSV { + cargarOIniciar(): DatosSistema\n+ cargar(): DatosSistema\n+ guardar(datos): void\n+ cargarTarifas(): ConfiguracionTarifas\n+ guardarTarifas(tarifas): void }
}
DatosSistema *-- Cliente
DatosSistema *-- Cancha
DatosSistema *-- Reserva
ArchivosCSV ..> DatosSistema
ArchivosCSV ..> ConfiguracionTarifas
GestionRegistros --> DatosSistema
GestionRegistros --> ArchivosCSV
GestionRegistros --> ServicioDisponibilidad
ServicioDashboard --> DatosSistema
ServicioReportes --> DatosSistema
ServicioReportes --> ResultadoReporte
CalculadoraTarifas --> ConfiguracionTarifas
Reserva ..> CalculadoraTarifas
package "Interfaz Swing" {
 class VentanaPrincipal
 class PanelesGestion
 class FormularioNuevaReserva
 class PanelReportes
 class PanelTienda
}
VentanaPrincipal --> DatosSistema
VentanaPrincipal --> PanelesGestion
VentanaPrincipal --> PanelReportes
VentanaPrincipal --> PanelTienda
FormularioNuevaReserva --> GestionRegistros
PanelesGestion --> GestionRegistros
PanelReportes --> ServicioReportes
package "Tienda opcional" {
 class Producto { - codigo: String\n- precio: BigDecimal\n- existencia: int\n+ vender(cantidad): void }
 class DetalleVenta { - productoCodigo: String\n- cantidad: int\n- precioUnitario: BigDecimal }
 class Venta { - codigo: String\n- detalles: List<DetalleVenta>\n- total: BigDecimal }
 class DatosTienda { - productos: List<Producto>\n- ventas: List<Venta> }
 class ServicioTienda { + registrarProducto(producto): void\n+ vender(...): Venta }
 class ArchivosTienda { + cargarOIniciar(): DatosTienda\n+ guardar(datos): void }
 class ConfiguracionModulos { + configurarTienda(activar): void }
}
Venta "1" o-- "1..*" DetalleVenta
DatosTienda *-- Producto
DatosTienda *-- Venta
ServicioTienda --> ArchivosTienda
ServicioTienda --> DatosTienda
PanelTienda --> ServicioTienda
VentanaPrincipal --> ConfiguracionModulos
@enduml
